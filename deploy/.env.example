# Public hostname for the MTUNZ signaling API (DNS A record -> VPS public IPv4).
MTUNZ_DOMAIN=signal.example.com

# Coturn realm and public address. If the VPS is behind NAT, set TURN_EXTERNAL_IP
# to public-ip/private-ip as described in deploy/README.md.
TURN_REALM=turn.example.com
TURN_EXTERNAL_IP=203.0.113.10

# Replace with: openssl rand -hex 32
# Use this exact same secret for the Go signaling service and coturn.
MTUNZ_TURN_SHARED_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
MTUNZ_TURN_CREDENTIAL_TTL_SECONDS=900

# TURN URLs advertised by the signaling server to MTUNZ clients.
MTUNZ_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
